<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>RamaverseStudio-Setup</AssemblyName>
    <RootNamespace>RamaverseStudio.Setup</RootNamespace>
    <Version>1.2.0.0</Version>
    <Product>Ramaverse Studio Setup</Product>
    <Company>Ramaverse</Company>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\publish\worldwide\RamaverseStudio.exe">
      <Link>Payload\RamaverseStudio.exe</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>
