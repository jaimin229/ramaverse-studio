<Window x:Class="RamaverseStudio.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ramaverse Studio • Setup Wizard"
        Height="420" Width="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0D0D11"
        Foreground="#FAFAFA"
        FontFamily="Segoe UI, Roboto, sans-serif"
        WindowStyle="SingleBorderWindow">

    <Border Background="#0D0D11" Padding="24">
        <Grid>
            <!-- HEADER -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="RAMAVERSE STUDIO" FontSize="18" FontWeight="Black" Foreground="#FFFFFF"/>
            <TextBlock Text="Streamer &amp; Creator Production Suite Setup" FontSize="12" Foreground="#3B82F6" FontWeight="SemiBold" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- MAIN BODY -->
        <Border Grid.Row="1" Background="#14141A" BorderBrush="#252530" BorderThickness="1" CornerRadius="8" Padding="16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatus" Text="Ready to install Ramaverse Studio v1.2.0 on this computer." FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <TextBlock Text="Install Directory:" FontSize="11" Foreground="#888899" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtInstallPath" Background="#0A0A0E" Foreground="#CCCCCC" BorderBrush="#333340" Padding="8,6" FontSize="12" IsReadOnly="True" Margin="0,0,0,14"/>

                <CheckBox x:Name="ChkDesktopShortcut" Content="Create Desktop Shortcut" IsChecked="True" Foreground="#E0E0E0" Margin="0,0,0,8"/>
                <CheckBox x:Name="ChkStartMenu" Content="Add to Windows Start Menu" IsChecked="True" Foreground="#E0E0E0" Margin="0,0,0,14"/>

                <ProgressBar x:Name="ProgressBarInstall" Height="8" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Background="#202028" Foreground="#3B82F6"/>
            </StackPanel>
        </Border>

        <!-- FOOTER BUTTONS -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtProgressDesc" Grid.Column="0" Text="Zero admin rights needed • Single-user install" FontSize="11" Foreground="#666677" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnCancel" Content="Cancel" Padding="14,8" Background="#1E1E26" BorderBrush="#383848" Foreground="#AAAAAA" FontWeight="SemiBold" Margin="0,0,8,0" Click="OnCancelClicked"/>
                <Button x:Name="BtnInstall" Content="Install Now" Padding="18,8" Background="#2563EB" BorderBrush="#3B82F6" Foreground="#FFFFFF" FontWeight="Bold" Click="OnInstallClicked"/>
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
