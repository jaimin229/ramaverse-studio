<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Obsidian & Radiant Purple Theme Palette (Default) -->
    <Color x:Key="Color.ChassisDeep">#040307</Color>
    <Color x:Key="Color.ChassisSurface">#0F0D1A</Color>
    <Color x:Key="Color.ChassisCard">#140E26</Color>
    <Color x:Key="Color.ChassisCardHover">#1C1438</Color>
    <Color x:Key="Color.Border">#2D224D</Color>
    <Color x:Key="Color.BorderSubtle">#1D1533</Color>

    <Color x:Key="Color.Accent">#7C3AED</Color>
    <Color x:Key="Color.AccentGlow">#C084FC</Color>
    <Color x:Key="Color.AccentHover">#9061F9</Color>

    <Color x:Key="Color.TextPrimary">#F3F4F6</Color>
    <Color x:Key="Color.TextSecondary">#9CA3AF</Color>
    <Color x:Key="Color.TextDim">#6B7280</Color>

    <Color x:Key="Color.Success">#10B981</Color>
    <Color x:Key="Color.Danger">#EF4444</Color>
    <Color x:Key="Color.Warning">#F59E0B</Color>

    <SolidColorBrush x:Key="Brush.ChassisDeep" Color="{StaticResource Color.ChassisDeep}" />
    <SolidColorBrush x:Key="Brush.ChassisSurface" Color="{StaticResource Color.ChassisSurface}" />
    <SolidColorBrush x:Key="Brush.ChassisCard" Color="{StaticResource Color.ChassisCard}" />
    <SolidColorBrush x:Key="Brush.ChassisCardHover" Color="{StaticResource Color.ChassisCardHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="{StaticResource Color.BorderSubtle}" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentGlow" Color="{StaticResource Color.AccentGlow}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextDim" Color="{StaticResource Color.TextDim}" />

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
</ResourceDictionary>
