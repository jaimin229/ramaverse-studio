<Window x:Class="RamaverseStudio.UI.RecordingCompletedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Recording Saved — Ramaverse Studio" Height="320" Width="540"
        WindowStartupLocation="CenterOwner"
        Background="#000000" Foreground="#FFFFFF"
        ResizeMode="NoResize" WindowStyle="ToolWindow">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#242424"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#666666"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0A0A0A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Recording Finished &amp; Encoded" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Your video production has been encoded and saved to disk." FontSize="11" Foreground="#888888" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Details Card -->
        <Border Grid.Row="1" Background="#0C0C0C" BorderBrush="#222222" BorderThickness="1" CornerRadius="4" Padding="14">
            <StackPanel VerticalAlignment="Center">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="FILE NAME:" FontSize="10" FontWeight="Bold" Foreground="#888888"/>
                    <TextBlock Grid.Column="1" x:Name="TxtFileName" Text="Ramaverse_2026-08-30.mp4" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="DURATION:" FontSize="10" FontWeight="Bold" Foreground="#888888"/>
                    <TextBlock Grid.Column="1" x:Name="TxtDuration" Text="00:02:45" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="FILE SIZE:" FontSize="10" FontWeight="Bold" Foreground="#888888"/>
                    <TextBlock Grid.Column="1" x:Name="TxtFileSize" Text="14.2 MB" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Play Video" Background="#FFFFFF" Foreground="#000000" BorderBrush="#FFFFFF" FontWeight="Bold" Click="OnPlayVideoClicked" Margin="0,0,8,0"/>
                <Button Content="Open in Folder" Click="OnOpenFolderClicked"/>
            </StackPanel>
            <Button Content="Done" HorizontalAlignment="Right" Width="80" Click="OnDoneClicked"/>
        </Grid>
    </Grid>
</Window>
