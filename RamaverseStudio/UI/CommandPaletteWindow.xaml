<Window x:Class="RamaverseStudio.UI.CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Command Palette"
        Width="620" Height="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        KeyDown="OnWindowKeyDown">

    <Border Background="{DynamicResource Brush.ChassisDeep}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1.5"
            CornerRadius="16"
            Padding="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="12" Opacity="0.75"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search Input Box -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.ChassisSurface}"
                    BorderBrush="{DynamicResource Brush.BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🔍" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1"
                             Background="Transparent"
                             Foreground="{DynamicResource Brush.TextPrimary}"
                             BorderThickness="0"
                             FontSize="14"
                             FontWeight="SemiBold"
                             CaretBrush="{DynamicResource Brush.AccentGlow}"
                             TextChanged="OnSearchTextChanged"/>
                    <Border Grid.Column="2" Background="{DynamicResource Brush.ChassisCard}" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="ESC to close" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.TextDim}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 1px CNC Hairline Divider -->
            <Border Grid.Row="1" Height="1" Background="{DynamicResource Brush.BorderSubtle}" Margin="0,10,0,6"/>

            <!-- Action Results List -->
            <ListBox x:Name="ActionListBox" Grid.Row="2"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnItemDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.ChassisCardHover}"/>
                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Brush.ChassisCard}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource Brush.TextDim}"/>
                            </StackPanel>

                            <Border Grid.Column="2" Background="{DynamicResource Brush.ChassisSurface}" CornerRadius="6" Padding="6,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Shortcut}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentGlow}"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Bottom Quick Tip Bar -->
            <Border Grid.Row="3" Background="{DynamicResource Brush.ChassisSurface}" CornerRadius="8" Padding="10,6" Margin="0,8,0,0">
                <DockPanel>
                    <TextBlock Text="⚡ Raycast Instant Mode" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentGlow}"/>
                    <TextBlock Text="Enter to Run  •  ↑↓ to Navigate" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource Brush.TextDim}"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
