<Window x:Class="RamaverseStudio.UI.LicenseActivationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ramaverse Studio - License &amp; Pro Activation"
        Width="520" Height="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource Brush.ChassisDeep}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        BorderBrush="{DynamicResource Brush.Border}"
        BorderThickness="1">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Plan comparison / Status card -->
            <RowDefinition Height="*"/>    <!-- Key input area -->
            <RowDefinition Height="Auto"/> <!-- Action buttons -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="RAMAVERSE STUDIO" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                <Border x:Name="BadgeTier" Background="#1E1438" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTierLabel" Text="STARTER FREE EDITION" FontSize="10" FontWeight="Bold" Foreground="#C084FC"/>
                </Border>
            </StackPanel>
            <TextBlock Text="Unlock unlimited 4K recording, Multi-Track audio, Voice Changer, Dual-Stream, and Virtual Camera."
                       FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 2. Pro Features Breakdown Box -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.ChassisSurface}" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="PRO CREATOR CAPABILITIES INCLUDED:" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.AccentGlow}" Margin="0,0,0,8"/>
                <TextBlock Text="• Multi-Track Audio MKV (Microphone + Discord + Game separate audio channels)" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,4"/>
                <TextBlock Text="• Simultaneous Dual-Canvas Live Streaming (16:9 YouTube + 9:16 Shorts/TikTok)" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,4"/>
                <TextBlock Text="• Sub-3ms Hardware Voice Changer &amp; SIMD Mechanical Click Denoiser" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,4"/>
                <TextBlock Text="• Zero-Latency Shared Memory Virtual Camera for Discord, Zoom &amp; Teams" FontSize="11" Foreground="{DynamicResource Brush.TextDim}" Margin="0,0,0,4"/>
                <TextBlock Text="• Blackmagic ATEM Broadcast Staging Deck with T-Bar Fader" FontSize="11" Foreground="{DynamicResource Brush.TextDim}"/>
            </StackPanel>
        </Border>

        <!-- 3. License Key Input -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="0,0,0,16">
            <TextBlock Text="Enter License Key:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtLicenseKey" Height="38" FontSize="13" FontFamily="Consolas" VerticalContentAlignment="Center" Padding="10,0"
                     Background="#08060D" BorderBrush="{DynamicResource Brush.Border}" Foreground="#FFFFFF"
                     ToolTip="Paste your license key in the format: RAMA-PRO-XXXX-XXXX"/>

            <TextBlock x:Name="TxtStatusMessage" Text="" FontSize="11" Foreground="#EF4444" Margin="0,6,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Hardware Machine ID: " FontSize="10" Foreground="{DynamicResource Brush.TextDim}"/>
                <TextBlock x:Name="TxtMachineId" Text="RAMA-HW-0000" FontSize="10" FontFamily="Consolas" Foreground="{DynamicResource Brush.TextSecondary}"/>
            </StackPanel>
        </StackPanel>

        <!-- 4. Action Buttons Footer -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnBuyLicense" Grid.Column="0" Content="Purchase Pro License ($49)" Style="{StaticResource TeAccentButton}" Padding="14,8" FontSize="11" FontWeight="Bold" Click="OnBuyLicenseClicked"/>
            
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="BtnStartTrial" Content="Start 7-Day Trial" Style="{StaticResource TeTactileButton}" Padding="12,8" FontSize="11" Margin="0,0,8,0" Click="OnStartTrialClicked"/>
                <Button x:Name="BtnActivate" Content="Activate Key" Style="{StaticResource TeSuccessButton}" Padding="14,8" FontSize="11" FontWeight="Bold" Click="OnActivateClicked"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
