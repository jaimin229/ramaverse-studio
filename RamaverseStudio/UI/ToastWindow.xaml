<Window x:Class="RamaverseStudio.UI.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toast"
        Width="360" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        ShowActivated="False">
    <Border x:Name="ToastBorder"
            Background="#F0101010"
            BorderBrush="#3A3A3A"
            BorderThickness="1"
            CornerRadius="6"
            Padding="14,10"
            Margin="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Severity glyph: vector, monochrome -->
            <Border x:Name="GlyphBadge" Grid.Column="0" Width="22" Height="22" CornerRadius="4"
                    Background="#FFFFFF" VerticalAlignment="Top" Margin="0,1,10,0">
                <TextBlock x:Name="GlyphText" Text="i" FontSize="13" FontWeight="Black"
                           Foreground="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="ToastText" Grid.Column="1"
                       Foreground="#FFFFFF" FontSize="12"
                       TextWrapping="Wrap" LineHeight="17"/>
        </Grid>
    </Border>
</Window>
