<Window x:Class="RamaverseStudio.UI.FFmpegSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="One-time setup — Ramaverse Studio"
        Height="420" Width="560"
        WindowStartupLocation="CenterOwner"
        Background="#000000" Foreground="#FFFFFF"
        ResizeMode="NoResize" WindowStyle="ToolWindow">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#666666"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Border Background="#FFFFFF" CornerRadius="4" Width="26" Height="26" Margin="0,0,10,0">
                    <TextBlock Text="R" FontSize="15" FontWeight="Black" Foreground="#000000"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Unlock Recording &amp; Streaming" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Ramaverse Studio needs FFmpeg (the industry-standard video engine) to record and stream. Get it in one click — no technical steps." FontSize="12" Foreground="#999999" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="17"/>
        </StackPanel>

        <!-- Body -->
        <Border Grid.Row="1" Background="#0F0F0F" BorderBrush="#262626" BorderThickness="1" CornerRadius="4" Padding="16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatusBig" Text="FFmpeg is not installed on this PC yet." FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtStatusDetail"
                           Text="Option 1 (recommended): click Download below — we'll install it for you automatically.&#x0a;&#x0a;Option 2: if you already have FFmpeg, add its bin folder to your Windows PATH and restart the app."
                           FontSize="12" Foreground="#BBBBBB" TextWrapping="Wrap" LineHeight="18"/>
                <ProgressBar x:Name="Progress" Height="6" Background="#1A1A1A" Foreground="#FFFFFF" BorderThickness="0"
                             Margin="0,14,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtProgressLabel" Text="" FontSize="10" Foreground="#888888" Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Button x:Name="BtnSkip" Content="Skip for now" HorizontalAlignment="Left" Click="OnSkipClicked"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnManualHelp" Content="Manual install guide" Margin="0,0,8,0" Click="OnManualHelpClicked"/>
                <Button x:Name="BtnDownload" Content="Download &amp; Install FFmpeg" Background="#FFFFFF" Foreground="#000000"
                        BorderBrush="#FFFFFF" FontWeight="Bold" Click="OnDownloadClicked"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
