<Window x:Class="RamaverseStudio.UI.ProjectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ramaverse Studio — Projector"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#000000"
        ShowInTaskbar="False"
        Topmost="False"
        KeyDown="OnProjectorKeyDown">
    <Grid>
        <!-- Mirrors the live compositor preview at native canvas resolution -->
        <Image x:Name="ProjectorImage" Stretch="Uniform"/>
    </Grid>
</Window>
