<Window x:Class="RamaverseStudio.UI.AutoConfigWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stream Setup Wizard - Ramaverse Studio"
        Width="680" Height="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.ChassisDeep}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        ResizeMode="NoResize"
        BorderBrush="{DynamicResource Brush.Border}"
        BorderThickness="1">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Stream and Recording Setup Wizard" 
                       FontSize="20" FontWeight="Bold" 
                       Foreground="{DynamicResource Brush.AccentGlow}"/>
            <TextBlock Text="We will test your computer hardware and configure the best stream settings automatically." 
                       FontSize="13" Foreground="{DynamicResource Brush.TextDim}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Step Indicator Progress Bar -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="Step1Badge" Grid.Column="0" Background="{DynamicResource Brush.Accent}" CornerRadius="6" Padding="10,6" Margin="0,0,6,0">
                <TextBlock Text="1. Stream Purpose" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Foreground="#FFFFFF"/>
            </Border>
            <Border x:Name="Step2Badge" Grid.Column="1" Background="{DynamicResource Brush.ChassisCard}" CornerRadius="6" Padding="10,6" Margin="3,0,3,0">
                <TextBlock Text="2. Hardware Test" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextDim}"/>
            </Border>
            <Border x:Name="Step3Badge" Grid.Column="2" Background="{DynamicResource Brush.ChassisCard}" CornerRadius="6" Padding="10,6" Margin="6,0,0,0">
                <TextBlock Text="3. Optimal Settings" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextDim}"/>
            </Border>
        </Grid>

        <!-- Dynamic Content Area -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.ChassisCard}" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="20">
            <Grid>
                <!-- Step 1: Usage Purpose -->
                <StackPanel x:Name="Step1Panel" Visibility="Visible">
                    <TextBlock Text="What do you plan to do most on Ramaverse Studio?" FontWeight="Bold" FontSize="15" Margin="0,0,0,16"/>

                    <RadioButton x:Name="RbGaming" IsChecked="True" GroupName="Purpose" Margin="0,0,0,12" Cursor="Hand">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Live Gaming Stream (Esports, High FPS)" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="Optimized for lowest in-game latency, high frame rates (60 FPS), and smooth video encoding." FontSize="11" Foreground="{DynamicResource Brush.TextDim}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="RbChatting" GroupName="Purpose" Margin="0,0,0,12" Cursor="Hand">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Just Chatting, Podcasts &amp; Talk Shows" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="Optimized for highest vocal clarity, webcam sharpness, and multi-chat responsiveness." FontSize="11" Foreground="{DynamicResource Brush.TextDim}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="RbRecordingOnly" GroupName="Purpose" Margin="0,0,0,12" Cursor="Hand">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Video Recording Only (YouTube &amp; High Quality Editing)" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="Optimized for maximum bitrate, lossless audio multi-track separation, and automatic chapter markers." FontSize="11" Foreground="{DynamicResource Brush.TextDim}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Step 2: Hardware Benchmark & Detection -->
                <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                    <TextBlock Text="Analyzing System Capabilities..." FontWeight="Bold" FontSize="15" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Primary Display:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}"/>
                        <TextBlock x:Name="TxtDisplayInfo" Grid.Column="1" Text="Detecting..." FontWeight="Bold"/>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Hardware Encoder:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}"/>
                        <TextBlock x:Name="TxtEncoderInfo" Grid.Column="1" Text="Detecting..." FontWeight="Bold"/>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Audio Device:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextDim}"/>
                        <TextBlock x:Name="TxtAudioInfo" Grid.Column="1" Text="Detecting..." FontWeight="Bold"/>
                    </Grid>

                    <Border Background="{DynamicResource Brush.ChassisSurface}" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                        <TextBlock Text="Hardware compatibility test passed. Your system is ready for low-latency broadcasting." FontSize="12" Foreground="{DynamicResource Brush.Success}"/>
                    </Border>
                </StackPanel>

                <!-- Step 3: Recommended Configuration Summary -->
                <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                    <TextBlock Text="Recommended Stream Profile Ready" FontWeight="Bold" FontSize="15" Margin="0,0,0,16"/>

                    <Border Background="{DynamicResource Brush.ChassisSurface}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Base Canvas:" Foreground="{DynamicResource Brush.TextDim}" Margin="0,3"/>
                            <TextBlock x:Name="TxtSummaryCanvas" Grid.Row="0" Grid.Column="1" Text="1920x1080 @ 60 FPS" FontWeight="Bold" Margin="0,3"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Video Encoder:" Foreground="{DynamicResource Brush.TextDim}" Margin="0,3"/>
                            <TextBlock x:Name="TxtSummaryEncoder" Grid.Row="1" Grid.Column="1" Text="NVIDIA NVENC (High Quality)" FontWeight="Bold" Margin="0,3"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Video Bitrate:" Foreground="{DynamicResource Brush.TextDim}" Margin="0,3"/>
                            <TextBlock x:Name="TxtSummaryBitrate" Grid.Row="2" Grid.Column="1" Text="6000 Kbps (CBR)" FontWeight="Bold" Margin="0,3"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Crash Protection:" Foreground="{DynamicResource Brush.TextDim}" Margin="0,3"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Enabled (Matroska Safe Remux)" FontWeight="Bold" Foreground="{DynamicResource Brush.Success}" Margin="0,3"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Click Apply Settings to start streaming with this optimized configuration." FontSize="12" Foreground="{DynamicResource Brush.TextDim}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer Navigation Buttons -->
        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource TeTactileButton}" Width="90" Click="OnCancelClicked"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnBack" Content="Back" Style="{StaticResource TeTactileButton}" Width="90" Margin="0,0,10,0" IsEnabled="False" Click="OnBackClicked"/>
                <Button x:Name="BtnNext" Content="Next" Style="{StaticResource TeAccentButton}" Width="130" Click="OnNextClicked"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
