<UserControl x:Class="RamaverseStudio.UI.AtemTBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="180" Width="130">
    <Border Background="{DynamicResource Brush.ChassisSurface}" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Tally indicators -->
                <RowDefinition Height="*"/>    <!-- T-Bar track and slider -->
                <RowDefinition Height="Auto"/> <!-- CUT & AUTO buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Tally Lights & SMPTE Frame Counter -->
            <StackPanel Grid.Row="0" Margin="0,0,0,6">
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Preview Tally (Amber) -->
                    <Border Grid.Column="0" Background="#1F180A" BorderBrush="#D97706" BorderThickness="1" CornerRadius="3" Padding="4,2" Margin="0,0,2,0">
                        <TextBlock x:Name="TxtTallyPreview" Text="PVW" FontSize="9" FontWeight="Bold" Foreground="#FBBF24" HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Program Tally (Red) -->
                    <Border Grid.Column="1" Background="#260D12" BorderBrush="#DC2626" BorderThickness="1" CornerRadius="3" Padding="4,2" Margin="2,0,0,0">
                        <TextBlock x:Name="TxtTallyProgram" Text="PGM" FontSize="9" FontWeight="Bold" Foreground="#F87171" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>

                <TextBlock x:Name="TxtTimecode" Text="00:00:00:00" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- 2. Hardware T-Bar Fader -->
            <Grid Grid.Row="1" Margin="0,2,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Calibrated scale markings -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock Text="100%" FontSize="8" Foreground="#666666"/>
                    <TextBlock Text=" 50%" FontSize="8" Foreground="#666666" Margin="0,16,0,16"/>
                    <TextBlock Text="  0%" FontSize="8" Foreground="#666666"/>
                </StackPanel>

                <!-- Vertical T-Bar Slider -->
                <Slider Grid.Column="1" x:Name="TBarSlider" Orientation="Vertical" Minimum="0.0" Maximum="1.0" Value="0.0"
                        HorizontalAlignment="Center" Cursor="Hand" ValueChanged="OnTBarValueChanged"/>
            </Grid>

            <!-- 3. Hardware CUT and AUTO Transition Buttons -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="CUT" Style="{StaticResource TeTactileButton}" Margin="0,0,2,0" Padding="0,5" FontSize="10" FontWeight="Bold" Click="OnCutClicked"/>
                <Button Grid.Column="1" Content="AUTO" Style="{StaticResource TeAccentButton}" Margin="2,0,0,0" Padding="0,5" FontSize="10" FontWeight="Bold" Click="OnAutoClicked"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
