<Window x:Class="RamaverseStudio.UI.FloatingDockHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floating Dock - Ramaverse Studio"
        Width="480" Height="650"
        WindowStartupLocation="Manual"
        Background="{DynamicResource Brush.ChassisDeep}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        BorderBrush="{DynamicResource Brush.Border}"
        BorderThickness="1"
        Closing="OnWindowClosing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Title and Re-Dock Bar -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.ChassisSurface}" BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <TextBlock x:Name="TxtDockTitle" Text="Detached Panel" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource Brush.AccentGlow}"/>
                <Button Content="Re-Dock to Main Window" Style="{StaticResource TeTactileButton}" HorizontalAlignment="Right" Padding="10,4" FontSize="11" Click="OnReDockClicked"/>
            </DockPanel>
        </Border>

        <!-- Host Content Container -->
        <ContentControl x:Name="DockContentHost" Grid.Row="1" Margin="12"/>
    </Grid>
</Window>
