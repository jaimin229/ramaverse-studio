<Window x:Class="RamaverseStudio.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings — Ramaverse Studio" Height="640" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="#000000" Foreground="#FFFFFF"
        ResizeMode="NoResize" WindowStyle="ToolWindow">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Studio Settings" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>

        <!-- Settings Tabs -->
        <TabControl Grid.Row="1" Background="#0C0C0C" BorderBrush="#262626" BorderThickness="1">

            <!-- Video & Canvas Tab -->
            <TabItem Header="VIDEO &amp; CANVAS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Text="CANVAS RESOLUTION &amp; ASPECT RATIO" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ComboCanvasFormat" Margin="0,0,0,18">
                            <ComboBoxItem Content="16:9 Landscape (1920x1080) — YouTube / Twitch"/>
                            <ComboBoxItem Content="9:16 Portrait (1080x1920) — Shorts / TikTok / Reels"/>
                            <ComboBoxItem Content="1:1 Square (1080x1080) — Instagram Post"/>
                            <ComboBoxItem Content="16:9 4K Ultra HD (3840x2160)"/>
                        </ComboBox>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="TARGET FRAMERATE (FPS)" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                                <ComboBox x:Name="ComboFps">
                                    <ComboBoxItem Content="60 FPS (Silky Smooth)"/>
                                    <ComboBoxItem Content="30 FPS (Standard Broadcast)"/>
                                    <ComboBoxItem Content="24 FPS (Cinematic)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="VIDEO ENCODER" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                                <ComboBox x:Name="ComboEncoder">
                                    <ComboBoxItem Content="Auto Hardware (Recommended)"/>
                                    <ComboBoxItem Content="NVIDIA NVENC H.264"/>
                                    <ComboBoxItem Content="NVIDIA NVENC HEVC (H.265)"/>
                                    <ComboBoxItem Content="AMD AMF H.264"/>
                                    <ComboBoxItem Content="Intel QuickSync H.264"/>
                                    <ComboBoxItem Content="Software (x264 CPU)"/>
                                    <ComboBoxItem Content="Software (SVT-AV1)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Recording Tab -->
            <TabItem Header="RECORDING">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Text="DESTINATION DIRECTORY" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtRecordingFolder" Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="Browse..." Padding="16,7" Click="OnBrowseFolderClicked"/>
                        </Grid>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="CONTAINER FORMAT" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                                <ComboBox x:Name="ComboRecFormat">
                                    <ComboBoxItem Content="MP4 (.mp4) — Standard"/>
                                    <ComboBoxItem Content="MKV (.mkv) — Crash-Proof"/>
                                    <ComboBoxItem Content="MOV (.mov) — Apple ProRes"/>
                                    <ComboBoxItem Content="WebM (.webm) — Open Video"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="RECORDING BITRATE" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                                <ComboBox x:Name="ComboRecBitrate">
                                    <ComboBoxItem Content="35000 kbps (4K Ultra High)"/>
                                    <ComboBoxItem Content="16000 kbps (High Quality 1080p60)"/>
                                    <ComboBoxItem Content="12000 kbps (Standard 1080p60)"/>
                                    <ComboBoxItem Content="8000 kbps (1080p30)"/>
                                    <ComboBoxItem Content="5000 kbps (Compact Storage)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Streaming Tab -->
            <TabItem Header="STREAMING">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Text="STREAMING PLATFORM" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ComboStreamPlatform" Margin="0,0,0,16" SelectionChanged="OnStreamPlatformChanged">
                            <ComboBoxItem Content="YouTube Live"/>
                            <ComboBoxItem Content="Twitch"/>
                            <ComboBoxItem Content="Kick"/>
                            <ComboBoxItem Content="Custom RTMP Server"/>
                        </ComboBox>

                        <TextBlock Text="RTMP SERVER URL" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtRtmpUrl" Margin="0,0,0,16"/>

                        <TextBlock Text="STREAM KEY (Required to Go Live)" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtStreamKey" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" x:Name="BtnToggleKeyMask" Content="👁 Show" Padding="12,7" Click="OnToggleKeyMaskClicked"/>
                        </Grid>

                        <TextBlock Text="STREAMING BITRATE" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ComboStreamBitrate" Margin="0,0,0,18">
                            <ComboBoxItem Content="8000 kbps (YouTube 1080p60 / Kick)"/>
                            <ComboBoxItem Content="6000 kbps (Twitch 1080p60 Max)"/>
                            <ComboBoxItem Content="4500 kbps (Balanced 720p60)"/>
                            <ComboBoxItem Content="3000 kbps (Low Bandwidth)"/>
                        </ComboBox>

                        <!-- Step-by-Step Guidance Box -->
                        <Border Background="#121212" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="4" Padding="14">
                            <StackPanel>
                                <TextBlock Text="💡 How to get your Stream Key:" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                                <TextBlock Text="1. Click the button below to open your channel's streaming studio in your browser." FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                                <TextBlock Text="2. Copy the 'Stream Key' from your dashboard and paste it in the box above." FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                                <TextBlock Text="3. Click 'Save Changes' -> then click '📡 GO LIVE' on the main window to start streaming!" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,12"/>
                                
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="🔗 Open YouTube Live Studio" Padding="10,6" Margin="0,0,8,0" Click="OnOpenYouTubeDashboardClicked"/>
                                    <Button Content="🔗 Open Twitch Dashboard" Padding="10,6" Margin="0,0,8,0" Click="OnOpenTwitchDashboardClicked"/>
                                    <Button Content="🔗 Open Kick Dashboard" Padding="10,6" Click="OnOpenKickDashboardClicked"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Audio Devices Tab -->
            <TabItem Header="AUDIO DEVICES">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <TextBlock Text="MICROPHONE / AUDIO INPUT" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ComboMicDevices" Margin="0,0,0,18"/>

                        <TextBlock Text="MONITORING OUTPUT / SPEAKERS" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ComboOutputDevices" Margin="0,0,0,18"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Updates Tab -->
            <TabItem Header="UPDATES &amp; ABOUT">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <Border Background="#121212" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="RAMAVERSE STUDIO" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Version 1.0.0 (x64 Windows Native Creator Suite)" FontSize="12" Foreground="#888888" Margin="0,4,0,14"/>
                                <TextBlock Text="Auto-updater checks for updates automatically on launch to keep your creator studio always up-to-date with new encoders, voice DSPs, and bug fixes." FontSize="12" Foreground="#CCCCCC" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"/>
                                <Button Content="Check for Updates Now" HorizontalAlignment="Left" Padding="16,8" Background="#FFFFFF" Foreground="#000000" BorderBrush="#FFFFFF" FontWeight="Bold" Click="OnCheckUpdatesNowClicked"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="OnCancelClicked" Margin="0,0,10,0" Padding="16,8"/>
                <Button Content="Save Changes" Background="#FFFFFF" Foreground="#000000" BorderBrush="#FFFFFF" FontWeight="Bold" Padding="20,8" Click="OnSaveClicked"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
