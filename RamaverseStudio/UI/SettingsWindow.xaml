<Window x:Class="RamaverseStudio.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Settings — Ramaverse Studio" Height="620" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="#000000" Foreground="#FFFFFF"
        ResizeMode="NoResize" WindowStyle="ToolWindow">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F0F0F"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0F0F0F"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#242424"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#666666"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0A0A0A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Studio Settings" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,16"/>

        <!-- Settings Tabs -->
        <TabControl Grid.Row="1" Background="#0C0C0C" BorderBrush="#222222" BorderThickness="1">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#888888"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="14,8"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Margin="0,0,2,0" CornerRadius="4,4,0,0">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#1A1A1A"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Video & Canvas Tab -->
            <TabItem Header="VIDEO &amp; CANVAS">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="CANVAS RESOLUTION &amp; ASPECT RATIO" FontSize="10" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ComboCanvasFormat" Margin="0,0,0,16">
                            <ComboBoxItem Content="16:9 Landscape (1920x1080) — YouTube / Twitch"/>
                            <ComboBoxItem Content="9:16 Portrait (1080x1920) — Shorts / TikTok / Reels"/>
                            <ComboBoxItem Content="1:1 Square (1080x1080) — Instagram Post"/>
                            <ComboBoxItem Content="16:9 4K Ultra HD (3840x2160)"/>
                        </ComboBox>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="TARGET FRAMERATE (FPS)" FontSize="10" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,5"/>
                                <ComboBox x:Name="ComboFps">
                                    <ComboBoxItem Content="60 FPS"/>
                                    <ComboBoxItem Content="30 FPS"/>
                                    <ComboBoxItem Content="24 FPS"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="VIDEO ENCODER" FontSize="10" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,5"/>
                                <ComboBox x:Name="ComboEncoder">
                                    <ComboBoxItem Content="Auto Hardware (Recommended)"/>
                                    <ComboBoxItem Content="NVIDIA NVENC H.264"/>
                                    <ComboBoxItem Content="NVIDIA NVENC HEVC (H.265)"/>
                                    <ComboBoxItem Content="AMD AMF H.264"/>
                                    <ComboBoxItem Content="Intel QuickSync H.264"/>
                                    <ComboBoxItem Content="Software (x264 CPU)"/>
                                    <ComboBoxItem Content="Software (SVT-AV1)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Recording Tab -->
            <TabItem Header="RECORDING">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="DESTINATION DIRECTORY" FontSize="10" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtRecordingFolder" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Browse..." Click="OnBrowseFolderClicked"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="CONTAINER FORMAT" FontSize="10" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,5"/>
                                <ComboBox x:Name="ComboRecFormat">
                                    <ComboBoxItem Content="MP4 (.mp4)"/>
                                    <ComboBoxItem Content="MKV (.mkv)"/>
                                    <ComboBoxItem Content="MOV (.mov)"/>
                                    <ComboBoxItem Content="WebM (.webm)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="RECORDING BITRATE" FontSize="10" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,5"/>
                                <ComboBox x:Name="ComboRecBitrate">
                                    <ComboBoxItem Content="35000 kbps (4K High)"/>
                                    <ComboBoxItem Content="16000 kbps (High 1080p60)"/>
                                    <ComboBoxItem Content="12000 kbps (Standard 1080p60)"/>
                                    <ComboBoxItem Content="8000 kbps (1080p30)"/>
                                    <ComboBoxItem Content="5000 kbps (Compact)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Streaming Tab -->
            <TabItem Header="STREAMING">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="STREAMING PLATFORM" FontSize="10" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ComboStreamPlatform" Margin="0,0,0,14" SelectionChanged="OnStreamPlatformChanged">
                            <ComboBoxItem Content="YouTube Live (rtmp://a.rtmp.youtube.com/live2)"/>
                            <ComboBoxItem Content="Twitch (rtmp://live.twitch.tv/app)"/>
                            <ComboBoxItem Content="Kick (rtmps://fa723fc1b171.global-contribute.live-video.net)"/>
                            <ComboBoxItem Content="Custom RTMP Server"/>
                        </ComboBox>

                        <TextBlock Text="RTMP SERVER URL" FontSize="10" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtRtmpUrl" Margin="0,0,0,14"/>

                        <TextBlock Text="STREAM KEY" FontSize="10" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtStreamKey" Margin="0,0,0,14"/>

                        <TextBlock Text="STREAMING BITRATE" FontSize="10" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ComboStreamBitrate">
                            <ComboBoxItem Content="8000 kbps (YouTube 1080p60 / Kick)"/>
                            <ComboBoxItem Content="6000 kbps (Twitch 1080p60)"/>
                            <ComboBoxItem Content="4500 kbps (Balanced 720p60)"/>
                            <ComboBoxItem Content="3000 kbps (Low Bandwidth)"/>
                        </ComboBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Audio Devices Tab -->
            <TabItem Header="AUDIO DEVICES">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <TextBlock Text="MICROPHONE / AUDIO INPUT" FontSize="10" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ComboMicDevices" Margin="0,0,0,16"/>

                        <TextBlock Text="MONITORING OUTPUT / SPEAKERS" FontSize="10" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ComboOutputDevices" Margin="0,0,0,16"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Updates Tab -->
            <TabItem Header="UPDATES &amp; ABOUT">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <Border Background="#050505" BorderBrush="#222222" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="RAMAVERSE STUDIO" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Version 1.0.0 (x64 Windows Native)" FontSize="12" Foreground="#888888" Margin="0,2,0,12"/>
                                <TextBlock Text="Auto-updater checks for updates automatically on launch to keep your creator studio always up-to-date." FontSize="11" Foreground="#CCCCCC" TextWrapping="Wrap" LineHeight="16" Margin="0,0,0,14"/>
                                <Button Content="Check for Updates Now" HorizontalAlignment="Left" Padding="14,6" Click="OnCheckUpdatesNowClicked"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="OnCancelClicked" Margin="0,0,10,0"/>
                <Button Content="Save Changes" Background="#FFFFFF" Foreground="#000000" BorderBrush="#FFFFFF" FontWeight="Bold" Click="OnSaveClicked"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
