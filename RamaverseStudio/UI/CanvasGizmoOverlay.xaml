<UserControl x:Class="RamaverseStudio.UI.CanvasGizmoOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="Transparent"
             ClipToBounds="True">
    <Canvas x:Name="OverlayCanvas" Background="Transparent">
        <!-- Safe Area Guides -->
        <Grid x:Name="GuidesGrid" Visibility="Collapsed" IsHitTestVisible="False">
            <!-- 9:16 Shorts/Reels Safe Margin -->
            <Rectangle x:Name="VerticalSafeGuide" Stroke="#40FFFFFF" StrokeThickness="1" StrokeDashArray="4 4" Visibility="Collapsed"/>
            <!-- 16:9 Title Safe -->
            <Rectangle x:Name="TitleSafeGuide" Stroke="#30FFFFFF" StrokeThickness="1" StrokeDashArray="3 3"/>
        </Grid>

        <!-- Selected Source Transform Gizmo -->
        <Canvas x:Name="GizmoContainer" Visibility="Collapsed">
            <!-- Bounding Box Outline -->
            <Rectangle x:Name="SelectionBox" Stroke="#FFFFFF" StrokeThickness="1.5" Fill="#0DFFFFFF" StrokeDashArray="3 3"
                       MouseLeftButtonDown="OnBoundingBoxMouseDown" Cursor="SizeAll"/>

            <!-- Rotate Handle Line -->
            <Line x:Name="RotateLine" Stroke="#FFFFFF" StrokeThickness="1.5"/>
            <!-- Rotate Handle -->
            <Ellipse x:Name="HandleRotate" Width="12" Height="12" Fill="#FFFFFF" Stroke="#000000" StrokeThickness="1.5"
                     Cursor="Hand" MouseLeftButtonDown="OnRotateHandleMouseDown"/>

            <!-- 8 Resize Handles -->
            <Rectangle x:Name="HandleNW" Width="8" Height="8" Fill="#FFFFFF" Stroke="#000000" StrokeThickness="1"
                       Cursor="SizeNWSE" MouseLeftButtonDown="OnHandleMouseDown" Tag="NW"/>
            <Rectangle x:Name="HandleN" Width="8" Height="8" Fill="#FFFFFF" Stroke="#000000" StrokeThickness="1"
                       Cursor="SizeNS" MouseLeftButtonDown="OnHandleMouseDown" Tag="N"/>
            <Rectangle x:Name="HandleNE" Width="8" Height="8" Fill="#FFFFFF" Stroke="#000000" StrokeThickness="1"
                       Cursor="SizeNESW" MouseLeftButtonDown="OnHandleMouseDown" Tag="NE"/>
            <Rectangle x:Name="HandleE" Width="8" Height="8" Fill="#FFFFFF" Stroke="#000000" StrokeThickness="1"
                       Cursor="SizeWE" MouseLeftButtonDown="OnHandleMouseDown" Tag="E"/>
            <Rectangle x:Name="HandleSE" Width="8" Height="8" Fill="#FFFFFF" Stroke="#000000" StrokeThickness="1"
                       Cursor="SizeNWSE" MouseLeftButtonDown="OnHandleMouseDown" Tag="SE"/>
            <Rectangle x:Name="HandleS" Width="8" Height="8" Fill="#FFFFFF" Stroke="#000000" StrokeThickness="1"
                       Cursor="SizeNS" MouseLeftButtonDown="OnHandleMouseDown" Tag="S"/>
            <Rectangle x:Name="HandleSW" Width="8" Height="8" Fill="#FFFFFF" Stroke="#000000" StrokeThickness="1"
                       Cursor="SizeNESW" MouseLeftButtonDown="OnHandleMouseDown" Tag="SW"/>
            <Rectangle x:Name="HandleW" Width="8" Height="8" Fill="#FFFFFF" Stroke="#000000" StrokeThickness="1"
                       Cursor="SizeWE" MouseLeftButtonDown="OnHandleMouseDown" Tag="W"/>
        </Canvas>
    </Canvas>
</UserControl>
