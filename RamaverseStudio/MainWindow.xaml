<Window x:Class="RamaverseStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RamaverseStudio"
        xmlns:ui="clr-namespace:RamaverseStudio.UI"
        mc:Ignorable="d"
        Title="Ramaverse Studio — Creator Suite" 
        Icon="Assets/logo.png"
        Height="880" Width="1440" MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#000000" Foreground="#FFFFFF"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>
        <!-- Pure Black & White Minimalist Palette -->
        <SolidColorBrush x:Key="BgDark" Color="#000000"/>
        <SolidColorBrush x:Key="PanelBg" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="PanelHeaderBg" Color="#121212"/>
        <SolidColorBrush x:Key="CardBg" Color="#0E0E0E"/>
        <SolidColorBrush x:Key="BorderDark" Color="#222222"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="TextMuted" Color="#777777"/>

        <!-- Universal Control Styles -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#141414"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#242424"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#666666"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0A0A0A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E0E0E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BgDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>  <!-- Top Toolbar -->
            <RowDefinition Height="*"/>   <!-- Main Studio Deck -->
            <RowDefinition Height="240"/> <!-- Bottom Sources & Audio Mixer -->
            <RowDefinition Height="28"/>  <!-- Stream Health Assistant -->
            <RowDefinition Height="26"/>  <!-- Status Telemetry Footer -->
        </Grid.RowDefinitions>

        <!-- ==================== 1. TOP HEADER & MAIN CONTROLS ==================== -->
        <Border Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- Logo & Profile -->
                    <ColumnDefinition Width="*"/>      <!-- Center Format Switcher -->
                    <ColumnDefinition Width="Auto"/>   <!-- Record / Go Live / Settings -->
                </Grid.ColumnDefinitions>

                <!-- Logo & Brand Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Width="34" Height="34" Margin="0,0,12,0" ClipToBounds="True" Background="#140E26" BorderBrush="#7C3AED" BorderThickness="1">
                        <Image Source="pack://application:,,,/Assets/logo.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="RAMAVERSE" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="STUDIO" FontSize="14" FontWeight="Normal" Foreground="#A855F7" Margin="5,0,0,0"/>
                            <Border Background="#1C1428" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.3" FontSize="9" FontWeight="Bold" Foreground="#C084FC"/>
                            </Border>
                            <Button x:Name="BtnProLicense" Content="UPGRADE PRO" Style="{StaticResource TeAccentButton}" Padding="6,1" Margin="8,0,0,0" FontSize="9" FontWeight="Bold" ToolTip="Activate or Manage Pro Creator License" Click="OnLicenseClicked"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtActiveProfile" Text="1920x1080 • 60 FPS • Master Broadcast" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Center Canvas Format Switcher -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#121212" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnFormat16x9" Content="16:9 Landscape" Padding="12,4" Margin="0,0,2,0" Background="#FFFFFF" Foreground="#000000" BorderBrush="#FFFFFF" FontWeight="Bold" ToolTip="Standard 16:9 Full Screen (1920x1080) for YouTube / Twitch" Click="OnFormat16x9Clicked"/>
                            <Button x:Name="BtnFormat9x16" Content="9:16 Shorts/Reels" Padding="12,4" Margin="0,0,2,0" Background="Transparent" Foreground="#888888" BorderBrush="Transparent" ToolTip="Vertical 9:16 Canvas (1080x1920) for YouTube Shorts, Instagram Reels &amp; TikTok" Click="OnFormat9x16Clicked"/>
                            <Button x:Name="BtnFormatSquare" Content="1:1 Square" Padding="12,4" Margin="0,0,2,0" Background="Transparent" Foreground="#888888" BorderBrush="Transparent" ToolTip="Square 1:1 Canvas (1080x1080) for Instagram Posts" Click="OnFormatSquareClicked"/>
                            <Button x:Name="BtnFormatDual" Content="◫ Dual Canvas" Padding="12,4" Background="Transparent" Foreground="#888888" BorderBrush="Transparent" ToolTip="Simultaneous Dual Canvas View" Click="OnFormatDualClicked"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Action Production Deck -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Setup Wizard for First-Time Streamers -->
                    <Button x:Name="BtnAutoConfigWizard" Content="SETUP WIZARD" Margin="0,0,8,0" Padding="10,6" Background="#1E1438" BorderBrush="#7C3AED" Foreground="#C084FC" FontWeight="Bold" ToolTip="Run Automatic 3-Step Stream Setup Wizard" Click="OnAutoConfigWizardClicked"/>

                    <!-- Commands Quick Launcher -->
                    <Button x:Name="BtnCommandPalette" Content="COMMANDS" Margin="0,0,8,0" Padding="10,6" Background="#161224" BorderBrush="#3B2D54" Foreground="#E2E8F0" FontWeight="SemiBold" ToolTip="Open Fast Action Launcher (Ctrl+K)" Click="OnCommandPaletteClicked"/>

                    <!-- Snapshot button -->
                    <Button x:Name="BtnSnapshot" Content="Snapshot" Margin="0,0,8,0" Padding="10,6" ToolTip="Take Instant Studio Screenshot (Ctrl+S)" Click="OnSnapshotClicked"/>

                    <!-- Instant Replay Clip button -->
                    <Button x:Name="BtnSaveReplay" Content="CLIP (30s)" Margin="0,0,8,0" Padding="10,6" Background="#1C1C1C" BorderBrush="#3A3A3A" Foreground="#FFFFFF" FontWeight="Bold" ToolTip="Save Instant 30-Second Replay / Short Clip (Ctrl+Shift+F10)" Click="OnSaveReplayClicked"/>

                    <!-- Virtual Camera Toggle button -->
                    <Button x:Name="BtnVirtualCam" Content="VIRTUAL CAM" Margin="0,0,8,0" Padding="10,6" Background="#181818" BorderBrush="#444444" Foreground="#FFFFFF" FontWeight="Bold" ToolTip="Start Virtual Camera for Discord / Zoom / Teams" Click="OnVirtualCamToggleClicked"/>

                    <!-- Pause Rec Button -->
                    <Button x:Name="BtnPauseRec" Content="Pause" Margin="0,0,8,0" Padding="10,6" Visibility="Collapsed" ToolTip="Pause Recording (Ctrl+P)" Click="OnPauseRecClicked"/>

                    <!-- Start/Stop Recording Button -->
                    <Button x:Name="BtnRecord" Content="RECORD" Background="#181818" BorderBrush="#444444" Foreground="#FFFFFF" Padding="14,6" Margin="0,0,8,0" FontWeight="Bold" ToolTip="Start Instant High-Quality MP4 Recording (Ctrl+R)" Click="OnRecordToggleClicked"/>

                    <!-- Go Live Streaming Button -->
                    <Button x:Name="BtnStream" Content="GO LIVE" Background="#181818" BorderBrush="#444444" Foreground="#FFFFFF" Padding="14,6" Margin="0,0,8,0" FontWeight="Bold" ToolTip="Broadcast Live to YouTube, Twitch, or Kick (Ctrl+L)" Click="OnStreamToggleClicked"/>

                    <!-- Studio Mode Toggle -->
                    <Button x:Name="BtnStudioMode" Content="STUDIO MODE" Margin="0,0,8,0" Padding="10,6" Background="#181818" BorderBrush="#3A3A3A" Foreground="#FFFFFF" FontWeight="Bold" ToolTip="Toggle Studio Mode (Preview Staging vs Program Live)" Click="OnStudioModeToggled"/>

                    <!-- Remote Touch Deck -->
                    <Button x:Name="BtnRemoteControl" Content="TOUCH DECK" Margin="0,0,8,0" Padding="10,6" Background="#181818" BorderBrush="#3A3A3A" Foreground="#FFFFFF" ToolTip="Mobile Touch Controller URL (Open on phone/tablet)" Click="OnRemoteControlClicked"/>

                    <!-- Streamer Guide & Tutorial -->
                    <Button x:Name="BtnTutorial" Content="GUIDE" Padding="10,6" Margin="0,0,8,0" Background="#1D2432" BorderBrush="#3B82F6" Foreground="#93C5FD" FontWeight="Bold" ToolTip="Open Streamer Masterclass &amp; Usage Guide (F1)" Click="OnTutorialClicked"/>

                    <!-- Studio Settings -->
                    <Button x:Name="BtnSettings" Content="Settings" Padding="10,6" Margin="0,0,8,0" ToolTip="Open Studio Audio, Video &amp; Streaming Settings" Click="OnSettingsClicked"/>

                    <!-- Recordings folder -->
                    <Button x:Name="BtnOpenRecordings" Content="Folder" Padding="10,6" ToolTip="Open the folder containing your recordings and snapshots (Ctrl+O)" Click="OnOpenRecordingsFolderClicked"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 2. MAIN PRODUCTION DECK ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="180" MaxWidth="300"/> <!-- Left: Scenes Panel -->
                <ColumnDefinition Width="*"/>                                   <!-- Center: Live Canvas Preview -->
                <ColumnDefinition Width="290" MinWidth="250" MaxWidth="380"/> <!-- Right: Properties & Filters Inspector -->
            </Grid.ColumnDefinitions>

            <!-- 2.1 LEFT PANEL: SCENES -->
            <Border Grid.Column="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="38"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="{StaticResource PanelHeaderBg}" Padding="10,0">
                        <Grid VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="SCENES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <Button Content="Pop Out" Padding="4,1" FontSize="9" Margin="6,0,0,0" ToolTip="Detach Scenes into Floating Window for 2nd Monitor" Click="OnUndockScenesClicked"/>
                            </StackPanel>
                            <ComboBox x:Name="ComboTransition" HorizontalAlignment="Right" FontSize="10" Padding="4,1" Width="105" SelectionChanged="OnTransitionSelectionChanged" ToolTip="Scene Switch Transition Effect">
                                <ComboBoxItem Content="Cut (Instant)"/>
                                <ComboBoxItem Content="Fade (300ms)" IsSelected="True"/>
                                <ComboBoxItem Content="Fade (600ms)"/>
                                <ComboBoxItem Content="Slide Left (400ms)"/>
                                <ComboBoxItem Content="Slide Right (400ms)"/>
                                <ComboBoxItem Content="Wipe Left (400ms)"/>
                                <ComboBoxItem Content="Wipe Right (400ms)"/>
                                <ComboBoxItem Content="Luma Wipe (500ms)"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Scene List -->
                    <ListBox Grid.Row="1" x:Name="ScenesListBox" Background="Transparent" BorderThickness="0" Margin="4" SelectionChanged="OnSceneSelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="#AAAAAA"/>
                                <Setter Property="Padding" Value="8,7"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="SceneBorder" Background="#0E0E0E" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="•" FontSize="14" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#666666"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="SceneBorder" Property="Background" Value="#222222"/>
                                                    <Setter TargetName="SceneBorder" Property="BorderBrush" Value="#555555"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="SceneBorder" Property="BorderBrush" Value="#383838"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Scene Actions Toolbar -->
                    <Border Grid.Row="2" Background="{StaticResource PanelHeaderBg}" Padding="6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="+ Add" Padding="6,3" Margin="0,0,3,0" ToolTip="Create New Scene" Click="OnAddSceneClicked"/>
                            <Button Content="- Del" Padding="6,3" Margin="0,0,3,0" ToolTip="Remove Selected Scene" Click="OnDeleteSceneClicked"/>
                            <Button Content="Clone" Padding="6,3" Margin="0,0,3,0" ToolTip="Duplicate Selected Scene" Click="OnDuplicateSceneClicked"/>
                            <Button Content="Rename" Padding="6,3" Margin="0,0,3,0" ToolTip="Rename Selected Scene" Click="OnRenameSceneClicked"/>
                            <Button Content="📦" Padding="5,3" Margin="0,0,2,0" ToolTip="Export Scene Collection (.rama archive)" Click="OnExportCollectionClicked"/>
                            <Button Content="📂" Padding="5,3" ToolTip="Import Scene Collection (.rama archive)" Click="OnImportCollectionClicked"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 2.2 CENTER PANEL: LIVE COMPOSITED CANVAS -->
            <Border Grid.Column="1" Background="#000000" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Canvas Header Info & Guides -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#121212" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock x:Name="TxtCanvasResBadge" Text="1920 x 1080 • 60 FPS" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                            <TextBlock x:Name="TxtActiveSceneName" Text="Scene: Main Studio" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkShowGuides" Content="Guides" Foreground="{StaticResource TextSecondary}" Margin="0,0,12,0" ToolTip="Toggle Safe Area &amp; Alignment Grid Guides" Checked="OnGuidesToggled" Unchecked="OnGuidesToggled"/>
                            <Button Content="Projector" Padding="8,3" FontSize="11" Margin="0,0,6,0" ToolTip="Open a fullscreen preview on another monitor (Esc to close)" Click="OnProjectorClicked"/>
                            <Button Content="Fit Screen" Padding="8,3" FontSize="11" ToolTip="Center and fit preview to window" Click="OnFitScreenClicked"/>
                        </StackPanel>
                    </Grid>

                    <!-- Live Viewport Container (border color doubles as stream health indicator) -->
                    <Border Grid.Row="1" x:Name="PreviewViewportBorder" Background="#050505" BorderBrush="#1C1C1C" BorderThickness="2" CornerRadius="4" ClipToBounds="True">
                        <Grid>
                            <!-- Single View Mode (Default) -->
                            <Viewbox x:Name="SingleCanvasViewbox" Stretch="Uniform" Visibility="Visible">
                                <Grid x:Name="CanvasContainerGrid" Width="1920" Height="1080">
                                    <!-- Compositor Live Output Image -->
                                    <Image x:Name="CanvasLiveImage" Stretch="Fill"/>

                                    <!-- Interactive Transform Gizmo & Safe Area Overlay -->
                                    <ui:CanvasGizmoOverlay x:Name="CanvasGizmo"/>
                                </Grid>
                            </Viewbox>

                            <!-- Studio Dual View Mode (Preview on Left, Program on Right) -->
                            <Grid x:Name="StudioDualGrid" Visibility="Collapsed" Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Preview (Staged) -->
                                <Border Grid.Column="0" Background="#0B0B0E" BorderBrush="#333333" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <TextBlock Text="PREVIEW (STAGING)" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6" FontSize="10" FontWeight="Bold" Foreground="#888888" Panel.ZIndex="10"/>
                                        <Viewbox Stretch="Uniform" Margin="2,22,2,2">
                                            <Grid Width="1920" Height="1080">
                                                <Image x:Name="StudioPreviewImage" Stretch="Fill"/>
                                                <ui:CanvasGizmoOverlay x:Name="StudioCanvasGizmo"/>
                                            </Grid>
                                        </Viewbox>
                                    </Grid>
                                </Border>

                                <!-- Center: ATEM Broadcast T-Bar Deck -->
                                <ui:AtemTBarControl x:Name="AtemSwitcher" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0"/>

                                <!-- Right: Program (Live Broadcast) -->
                                <Border Grid.Column="2" Background="#0B0B0E" BorderBrush="#ef4444" BorderThickness="1" CornerRadius="4">
                                    <Grid>
                                        <TextBlock Text="PROGRAM (LIVE)" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,6" FontSize="10" FontWeight="Bold" Foreground="#ef4444" Panel.ZIndex="10"/>
                                        <Viewbox Stretch="Uniform" Margin="2,22,2,2">
                                            <Grid Width="1920" Height="1080">
                                                <Image x:Name="StudioProgramImage" Stretch="Fill"/>
                                            </Grid>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 2.3 RIGHT PANEL: PROPERTIES & INSPECTOR -->
            <Border Grid.Column="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header Tabs -->
                    <Border Grid.Row="0" Background="{StaticResource PanelHeaderBg}" Padding="6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnTabInspector" Content="PROPERTIES" Padding="8,4" Margin="0,0,4,0" Background="#242424" BorderBrush="#444444" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10" Click="OnTabInspectorClicked"/>
                            <Button x:Name="BtnTabChat" Content="CHAT &amp; ALERTS" Padding="8,4" Background="Transparent" BorderBrush="Transparent" Foreground="#888888" FontSize="10" Click="OnTabChatClicked"/>
                        </StackPanel>
                    </Border>

                    <!-- Tab 1: Inspector Container -->
                    <Grid x:Name="InspectorContainerGrid" Grid.Row="1">
                        <!-- Empty Inspector Placeholder -->
                        <Grid x:Name="InspectorEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="◈" FontSize="28" Foreground="#444444" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="No Source Selected" FontSize="13" FontWeight="Bold" Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Click a layer in the Sources list to edit position, crop, green screen &amp; color grading." FontSize="11" Foreground="#666666" TextWrapping="Wrap" TextAlignment="Center" LineHeight="16"/>
                            </StackPanel>
                        </Grid>

                        <!-- Inspector Body -->
                        <ScrollViewer x:Name="InspectorScrollViewer" VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel x:Name="InspectorPanel">
                            <!-- Selected Source Title (editable) -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtInspectorSourceName" Text="No Source Selected" FontSize="13" FontWeight="SemiBold"
                                         Background="#0A0A0A" BorderBrush="#222222" TextChanged="OnInspectorRenameChanged"
                                         ToolTip="Rename this source"/>
                                <Button Grid.Column="1" x:Name="BtnApplyRename" Content="✓" Width="30" Margin="4,0,0,0" Padding="0"
                                        Visibility="Collapsed" FontWeight="Bold" ToolTip="Apply rename" Click="OnApplyRenameClicked"/>
                            </Grid>

                            <!-- TRANSFORM SECTION -->
                            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="TRANSFORM &amp; POSITION" FontSize="10" FontWeight="Bold" Foreground="#AAAAAA" Margin="0,0,0,10"/>
                                    
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="POS X" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtPropX" Text="0" TextChanged="OnTransformPropChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="POS Y" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtPropY" Text="0" TextChanged="OnTransformPropChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="WIDTH" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtPropWidth" Text="1920" TextChanged="OnTransformPropChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="HEIGHT" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtPropHeight" Text="1080" TextChanged="OnTransformPropChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Opacity" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="SliderPropOpacity" Minimum="0" Maximum="1" Value="1" ValueChanged="OnOpacityPropChanged"/>
                                        <TextBlock Grid.Column="2" x:Name="TxtPropOpacityVal" Text="100%" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Rotation" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="SliderPropRotation" Minimum="-180" Maximum="180" Value="0" ValueChanged="OnRotationPropChanged"/>
                                        <TextBlock Grid.Column="2" x:Name="TxtPropRotationVal" Text="0°" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <Button Content="Fit Screen" Padding="10,4" FontSize="11" Margin="0,0,4,0" ToolTip="Stretch source to fit full canvas dimensions" Click="OnFitSourceToScreenClicked"/>
                                        <Button Content="Center" Padding="10,4" FontSize="11" Margin="0,0,4,0" ToolTip="Center source inside canvas" Click="OnCenterSourceClicked"/>
                                        <Button Content="Reset" Padding="10,4" FontSize="11" ToolTip="Reset rotation and opacity to default" Click="OnResetTransformClicked"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- CROP SECTION -->
                            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="CROP (PIXELS FROM EACH EDGE)" FontSize="10" FontWeight="Bold" Foreground="#AAAAAA" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="LEFT" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtPropCropL" Text="0" TextChanged="OnCropPropChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="TOP" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtPropCropT" Text="0" TextChanged="OnCropPropChanged"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="RIGHT" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtPropCropR" Text="0" TextChanged="OnCropPropChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="BOTTOM" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtPropCropB" Text="0" TextChanged="OnCropPropChanged"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- TEXT PROPERTIES (Text sources only) -->
                            <Border x:Name="PanelTextProps" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="TEXT CONTENT" FontSize="10" FontWeight="Bold" Foreground="#AAAAAA" Margin="0,0,0,10"/>
                                    <TextBox x:Name="TxtPropTextContent" Text="" TextChanged="OnTextContentPropChanged" Margin="0,0,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="FONT SIZE (PX)" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3"/>
                                            <TextBox x:Name="TxtPropFontSize" Text="44" TextChanged="OnTextContentPropChanged"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- CAMERA CONTROLS (Webcam sources only) -->
                            <Border x:Name="PanelCameraControls" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="CAMERA" FontSize="10" FontWeight="Bold" Foreground="#AAAAAA" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="ChkPropFlipH" Content="Mirror horizontally" Foreground="#CCCCCC" Checked="OnFlipPropChanged" Unchecked="OnFlipPropChanged"/>
                                </StackPanel>
                            </Border>

                            <!-- PHONE RECONNECT (Phone sources only) -->
                            <Border x:Name="PanelPhoneReconnect" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="PHONE CAMERA" FontSize="10" FontWeight="Bold" Foreground="#AAAAAA" Margin="0,0,0,8"/>
                                    <Button Content="Reconnect Stream" Padding="10,4" HorizontalAlignment="Left" ToolTip="Reconnect to the phone camera MJPEG stream" Click="OnReconnectPhoneClicked"/>
                                </StackPanel>
                            </Border>

                            <!-- CHROMA KEY (GREEN SCREEN) SECTION -->
                            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox x:Name="ChkPropChromaKey" Content="CHROMA KEY (GREEN SCREEN)" FontWeight="Bold" FontSize="10" Foreground="#FFFFFF" Margin="0,0,0,10" ToolTip="Remove green background from webcam" Checked="OnChromaKeyPropChanged" Unchecked="OnChromaKeyPropChanged"/>
                                    
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Similarity" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="SliderChromaSimilarity" Minimum="0" Maximum="1" Value="0.35" ValueChanged="OnChromaKeyPropChanged"/>
                                        <TextBlock Grid.Column="2" x:Name="TxtChromaSimVal" Text="35%" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Smoothness" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="SliderChromaSmoothness" Minimum="0" Maximum="1" Value="0.10" ValueChanged="OnChromaKeyPropChanged"/>
                                        <TextBlock Grid.Column="2" x:Name="TxtChromaSmoothVal" Text="10%" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Spill Reduce" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="SliderChromaSpill" Minimum="0" Maximum="1" Value="0.50" ValueChanged="OnChromaKeyPropChanged"/>
                                        <TextBlock Grid.Column="2" x:Name="TxtChromaSpillVal" Text="50%" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- VIDEO PROC AMP / COLOR ADJUSTMENTS -->
                            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="12">
                                <StackPanel>
                                    <CheckBox x:Name="ChkPropColorAdjust" Content="COLOR ADJUST / PROC AMP" FontWeight="Bold" FontSize="10" Foreground="#FFFFFF" Margin="0,0,0,10" ToolTip="Fine-tune lighting, contrast, and color balance" Checked="OnColorAdjustPropChanged" Unchecked="OnColorAdjustPropChanged"/>
                                    
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Brightness" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="SliderPropBrightness" Minimum="-50" Maximum="50" Value="0" ValueChanged="OnColorAdjustPropChanged"/>
                                        <TextBlock Grid.Column="2" x:Name="TxtPropBrightVal" Text="0" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Contrast" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="SliderPropContrast" Minimum="0.5" Maximum="2.0" Value="1.0" ValueChanged="OnColorAdjustPropChanged"/>
                                        <TextBlock Grid.Column="2" x:Name="TxtPropContrastVal" Text="1.0" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Saturation" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="SliderPropSaturation" Minimum="0" Maximum="2.0" Value="1.0" ValueChanged="OnColorAdjustPropChanged"/>
                                        <TextBlock Grid.Column="2" x:Name="TxtPropSatVal" Text="1.0" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Gamma" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1" x:Name="SliderPropGamma" Minimum="0.5" Maximum="2.0" Value="1.0" ValueChanged="OnColorAdjustPropChanged"/>
                                        <TextBlock Grid.Column="2" x:Name="TxtPropGammaVal" Text="1.0" FontSize="11" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    </Grid>

                    <!-- Tab 2: Live Chat & Alerts Dock -->
                    <Grid x:Name="ChatContainerGrid" Grid.Row="1" Visibility="Collapsed">
                        <ui:LiveChatDockControl x:Name="LiveChatDock"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 3. BOTTOM PANEL: SOURCES & AUDIO MIXER ==================== -->
        <Border Grid.Row="2" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/> <!-- Sources List -->
                    <ColumnDefinition Width="*"/>   <!-- Audio Mixer & DSP Studio -->
                    <ColumnDefinition Width="280"/> <!-- Quick Control Center & Stats -->
                </Grid.ColumnDefinitions>

                <!-- 3.1 SOURCES MANAGER -->
                <Border Grid.Column="0" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="38"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource PanelHeaderBg}" Padding="12,0">
                            <TextBlock Text="SOURCES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Empty Sources Overlay -->
                        <Grid x:Name="SourcesEmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="No sources added yet" FontSize="12" FontWeight="Bold" Foreground="#888888" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                <TextBlock Text="Click '+ Add Source...' below to add a Screen, Camera, or Window." FontSize="10" Foreground="#555555" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- Sources List -->
                        <ListBox Grid.Row="1" x:Name="SourcesListBox" Background="Transparent" BorderThickness="0" Margin="4" SelectionChanged="OnSourceSelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Foreground" Value="#AAAAAA"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="SrcBorder" Background="#0E0E0E" BorderBrush="#1C1C1C" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="•" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#666666"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <!-- Visibility -->
                                                        <Button Grid.Column="2" x:Name="BtnVis" Content="👁" Padding="4,1" Margin="0,0,4,0" Background="Transparent" BorderBrush="Transparent" ToolTip="Toggle Visibility" Tag="{Binding}" Click="OnToggleVisibilityClicked"/>
                                                        <!-- Lock -->
                                                        <Button Grid.Column="3" x:Name="BtnLck" Content="🔓" Padding="4,1" Background="Transparent" BorderBrush="Transparent" ToolTip="Lock/Unlock Position" Tag="{Binding}" Click="OnToggleLockClicked"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="SrcBorder" Property="Background" Value="#222222"/>
                                                        <Setter TargetName="SrcBorder" Property="BorderBrush" Value="#555555"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- Sources Toolbar -->
                        <Border Grid.Row="2" Background="{StaticResource PanelHeaderBg}" Padding="8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="+ Add Source..." Padding="12,5" Margin="0,0,4,0" Background="#FFFFFF" Foreground="#000000" BorderBrush="#FFFFFF" FontWeight="Bold" ToolTip="Add Screen, Window, Camera, Image, or Text source" Click="OnAddSourceClicked"/>
                                <Button Content="- Del" Padding="8,5" Margin="0,0,4,0" ToolTip="Delete selected source (Del key)" Click="OnDeleteSourceClicked"/>
                                <Button Content="▲ Up" Padding="8,5" Margin="0,0,4,0" ToolTip="Move source layer up in Z-stack" Click="OnMoveSourceUpClicked"/>
                                <Button Content="▼ Down" Padding="8,5" ToolTip="Move source layer down in Z-stack" Click="OnMoveSourceDownClicked"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 3.2 AUDIO MIXER & DSP METERS -->
                <Border Grid.Column="1" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource PanelHeaderBg}" Padding="12,0">
                            <Grid VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="AUDIO MIXER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <!-- Quick Streamer Soundboard Triggers -->
                                    <Button Content="Horn" Padding="6,2" FontSize="10" Margin="0,0,3,0" ToolTip="Play Airhorn SFX into Stream" Click="OnSfxAirhornClicked"/>
                                    <Button Content="Win" Padding="6,2" FontSize="10" Margin="0,0,3,0" ToolTip="Play Victory Chime SFX into Stream" Click="OnSfxVictoryClicked"/>
                                    <Button Content="Level" Padding="6,2" FontSize="10" Margin="0,0,3,0" ToolTip="Play Level Up SFX into Stream" Click="OnSfxLevelUpClicked"/>
                                    <Button Content="Laser" Padding="6,2" FontSize="10" Margin="0,0,3,0" ToolTip="Play Laser Beam SFX into Stream" Click="OnSfxLaserClicked"/>
                                    <Button Content="Buzz" Padding="6,2" FontSize="10" Margin="0,0,3,0" ToolTip="Play Buzzer SFX into Stream" Click="OnSfxBuzzerClicked"/>
                                    <Button Content="Clap" Padding="6,2" FontSize="10" Margin="0,0,3,0" ToolTip="Play Applause SFX into Stream" Click="OnSfxApplauseClicked"/>
                                    <CheckBox x:Name="ChkAutoClipper" Content="AI Clip" Foreground="#888888" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"
                                              ToolTip="AI Auto-Clipper: when your audio peaks with excitement, automatically save a 9:16 vertical clip" Checked="OnAutoClipperToggled" Unchecked="OnAutoClipperToggled"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Pop Out" Padding="6,2" FontSize="10" Margin="0,0,6,0" ToolTip="Detach Audio Mixer into Floating Window (Multi-Monitor)" Click="OnUndockMixerClicked"/>
                                    <Button Content="DSP Effects Rack" Padding="10,4" FontSize="11" ToolTip="Configure Voice Presets, Noise Gate, EQ, Compressor &amp; Limiter" Click="OnOpenAudioRackClicked"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="14,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Mic Channel -->
                            <Border Grid.Row="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TxtMicHeader" Text="Microphone Input" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                            <Border x:Name="BadgeVoiceChanger" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="8,0,0,0">
                                                <TextBlock x:Name="TxtVoicePresetLabel" Text="Clean" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </Border>
                                            <CheckBox x:Name="ChkMonitorMic" Content="Monitor" Foreground="#888888" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"
                                                      ToolTip="Hear your processed microphone in your headphones (exactly what the audience hears)" Checked="OnMonitorToggled" Unchecked="OnMonitorToggled"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtMicLevelDb" Text="-60.0 dB" HorizontalAlignment="Right" FontSize="11" Foreground="#FFFFFF" FontWeight="Bold"/>
                                    </Grid>

                                    <!-- Peak Meter -->
                                    <ui:AudioMeterControl Grid.Row="1" x:Name="MeterMic" Margin="0,6,0,6"/>

                                    <!-- Volume Slider & Mute -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnMuteMic" Content="Mute" Padding="8,3" Margin="0,0,8,0" ToolTip="Mute/Unmute Microphone" Click="OnMuteMicClicked"/>
                                        <Slider Grid.Column="1" x:Name="SliderMicVolume" Minimum="0" Maximum="1.5" Value="1.0" ToolTip="Microphone Volume Gain" ValueChanged="OnMicVolumeChanged"/>
                                        <TextBlock Grid.Column="2" x:Name="TxtMicVolVal" Text="100% (0.0 dB)" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Desktop Audio Channel -->
                            <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="10,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <TextBlock x:Name="TxtDesktopHeader" Text="Desktop / Game Audio" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        <TextBlock x:Name="TxtDesktopLevelDb" Text="-60.0 dB" HorizontalAlignment="Right" FontSize="11" Foreground="#FFFFFF" FontWeight="Bold"/>
                                    </Grid>

                                    <ui:AudioMeterControl Grid.Row="1" x:Name="MeterDesktop" Margin="0,6,0,6"/>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnMuteDesktop" Content="Mute" Padding="8,3" Margin="0,0,8,0" ToolTip="Mute/Unmute Desktop Audio" Click="OnMuteDesktopClicked"/>
                                        <Slider Grid.Column="1" x:Name="SliderDesktopVolume" Minimum="0" Maximum="1.0" Value="0.8" ToolTip="Desktop / Game Audio Volume" ValueChanged="OnDesktopVolumeChanged"/>
                                        <TextBlock Grid.Column="2" x:Name="TxtDesktopVolVal" Text="80% (-1.9 dB)" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 3.3 QUICK STUDIO TELEMETRY & STATUS -->
                <Border Grid.Column="2" Background="{StaticResource PanelBg}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource PanelHeaderBg}" Padding="12,0">
                            <TextBlock Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Row="1" Margin="12,10">
                            <!-- Recording Status Box -->
                            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="RECORDING" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock x:Name="TxtRecStatus" Text="STANDBY" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" Foreground="#888888"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtRecDuration" Text="00:00:00" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,3,0,1"/>
                                    <TextBlock x:Name="TxtRecSize" Text="Size: 0.0 MB • MP4" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                </StackPanel>
                            </Border>

                            <!-- Stream Status Box -->
                            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="10">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock x:Name="TxtStreamHeader" Text="LIVE STREAM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                        <TextBlock x:Name="TxtStreamStatus" Text="OFFLINE" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" Foreground="#888888"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtStreamUptime" Text="00:00:00" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,3,0,1"/>
                                    <TextBlock x:Name="TxtStreamBitrate" Text="Primary: 0 kbps • 0% drops" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="TxtSecStreamBitrate" Text="Vertical 9:16: OFFLINE" FontSize="9" Foreground="#666666" Margin="0,2,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 3.5 STREAM HEALTH ASSISTANT & LIVE TROUBLESHOOTING ==================== -->
        <Border Grid.Row="3" Background="#0C0A14" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#1C1428" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,10,0">
                        <TextBlock Text="STREAM ASSISTANT" FontSize="9" FontWeight="Bold" Foreground="#C084FC"/>
                    </Border>
                    <TextBlock x:Name="TxtDiagnosticTip" Text="Hardware &amp; Direct3D engine healthy. Zero dropped frames." FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="BtnQuickFix" Content="1-Click Fix: Lower Bitrate" HorizontalAlignment="Right" Padding="8,2" FontSize="10" Visibility="Collapsed" Click="OnQuickFixClicked"/>
            </Grid>
        </Border>

        <!-- ==================== 4. FOOTER TELEMETRY STATUS BAR ==================== -->
        <Border Grid.Row="4" Background="#050505" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtStatusFps" Text="FPS: 60.0" FontSize="10" Foreground="#FFFFFF" FontWeight="Bold" Margin="0,0,16,0"/>
                    <TextBlock x:Name="TxtStatusDropped" Text="Dropped: 0 (0.0%)" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,16,0"/>
                    <TextBlock x:Name="TxtStatusCpu" Text="CPU: 3.2%" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,16,0"/>
                    <TextBlock x:Name="TxtStatusRam" Text="RAM: 148 MB" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,16,0"/>
                    <TextBlock x:Name="TxtStatusEncoder" Text="Encoder: Auto Hardware" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="TxtAutoTier" Text="Auto: detecting…" FontSize="10" Foreground="#888888"
                               FontWeight="SemiBold" Margin="0,0,12,0"
                               ToolTip="Ramaverse auto-tuned the engine to this machine's hardware"/>
                    <TextBlock Text="Ready" FontSize="10" Foreground="#888888" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
